 tllama-server-core (= ${binary:Version}),
 tllama-server-backend-cpu (= ${binary:Version}),
 ${shlibs:Depends},
 ${misc:Depends}
Description: TLlama dynamically loadable Vulkan backend
 This package contains the Vulkan compute plugin for the private server
 runtime. Device support is provided by the system Vulkan drivers.

Package: tllama-server-backend-rocm10.1
Architecture: amd64
Build-Profiles: <!pkg.tllama-server.cpu-only !pkg.tllama-server.vulkan-only !pkg.tllama-server.rocm-only !pkg.tllama-server.cuda12.4-only !pkg.tllama-server.cuda12.9-only !pkg.tllama-server.cuda13.3-only !pkg.tllama-server.sycl-only> <pkg.tllama-server.rocm-only> <pkg.tllama-server.all>
Provides: tllama-server-backend-rocm (= ${binary:Version})
Depends:
 tllama-server-core (= ${binary:Version}),
 tllama-server-backend-cpu (= ${binary:Version}),
 amdrocm-runtime10.1,
 amdrocm-blas10.1,
 ${shlibs:Depends},
 ${misc:Depends}
Description: TLlama dynamically loadable ROCm 10.1 HIP backend
 This package provides GPU inference on AMD architectures supported by
 ROCm Core SDK 10.1. It includes compatible kernel dispatch for gfx1250.
 Legacy Vega gfx900, gfx906 and gfx90c kernels are not included.
 Versioned ROCm backends can coexist; alternatives selects the default.

Package: tllama-server-backend-cuda12.4
Architecture: amd64
Build-Profiles: <!pkg.tllama-server.cpu-only !pkg.tllama-server.vulkan-only !pkg.tllama-server.rocm-only !pkg.tllama-server.cuda12.4-only !pkg.tllama-server.cuda12.9-only !pkg.tllama-server.cuda13.3-only !pkg.tllama-server.sycl-only> <pkg.tllama-server.cuda12.4-only> <pkg.tllama-server.all>
Provides: tllama-server-backend-cuda (= ${binary:Version})
Depends:
 tllama-server-core (= ${binary:Version}),
 tllama-server-backend-cpu (= ${binary:Version}),
 ${shlibs:Depends},
 ${misc:Depends}
Description: TLlama dynamically loadable CUDA 12.4 backend
 This package provides NVIDIA GPU inference using Debian's CUDA 12.4
 runtime. It supports Maxwell, Pascal including Tesla P100, Volta, Turing,
 Ampere, Ada and Hopper GPUs with a compatible NVIDIA driver.
 Versioned CUDA backends can coexist; alternatives selects the default.

