Depends:
 tllama-server-core (= ${binary:Version}),
 tllama-server-backend-cpu (= ${binary:Version}),
 cuda-cudart-13-3,
 libcublas-13-3,
 ${shlibs:Depends},
 ${misc:Depends}
Description: TLlama dynamically loadable CUDA 13.3 backend
 This package provides NVIDIA GPU inference using the versioned CUDA 13.3
 runtime for Turing through Blackwell GPUs, with an NVIDIA 580 or newer
 driver. Maxwell, Pascal and Volta GPUs require a CUDA 12.x backend.
 Versioned CUDA backends can coexist; alternatives selects the default.

Package: tllama-server-backend-sycl
Architecture: amd64
Build-Profiles: <!pkg.tllama-server.cpu-only !pkg.tllama-server.vulkan-only !pkg.tllama-server.rocm-only !pkg.tllama-server.cuda12.4-only !pkg.tllama-server.cuda12.9-only !pkg.tllama-server.cuda13.3-only !pkg.tllama-server.sycl-only> <pkg.tllama-server.sycl-only> <pkg.tllama-server.all>
Depends:
 tllama-server-core (= ${binary:Version}),
 tllama-server-backend-cpu (= ${binary:Version}),
 intel-oneapi-compiler-dpcpp-cpp-runtime,
 intel-oneapi-mkl-sycl-blas,
 intel-oneapi-dnnl,
 intel-oneapi-tbb,
 ${shlibs:Depends},
 ${misc:Depends}
Description: TLlama dynamically loadable Intel SYCL backend
 This package provides Intel GPU inference through oneAPI SYCL and
 Level Zero. It enables FP16 kernels, oneMKL SYCL BLAS, oneDNN and graph
 execution. A compatible Intel compute driver is required.
