 ${shlibs:Depends},
 ${misc:Depends}
Description: TLlama dynamically loadable CUDA 12.9 backend
 This package provides NVIDIA GPU inference using the versioned CUDA 12.9
 runtime. It supports Maxwell through Blackwell GPUs, including Pascal
 Tesla P100, with a compatible NVIDIA driver.
 Versioned CUDA backends can coexist; alternatives selects the default.

Package: tllama-server-backend-cuda13.3
Architecture: amd64
Build-Profiles: <!pkg.tllama-server.cpu-only !pkg.tllama-server.vulkan-only !pkg.tllama-server.rocm-only !pkg.tllama-server.cuda12.4-only !pkg.tllama-server.cuda12.9-only !pkg.tllama-server.cuda13.3-only !pkg.tllama-server.sycl-only> <pkg.tllama-server.cuda13.3-only> <pkg.tllama-server.all>
