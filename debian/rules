#!/usr/bin/make -f

COMPONENT_ORDER := cpu vulkan rocm cuda12.4 cuda12.9 cuda13.3 sycl
ONLY_PROFILES := $(addprefix pkg.tllama-server.,$(addsuffix -only,$(COMPONENT_ORDER)))
TLLAMA_PROFILES := $(filter pkg.tllama-server.%,$(DEB_BUILD_PROFILES))
UNKNOWN_PROFILES := $(filter-out $(ONLY_PROFILES) pkg.tllama-server.all,$(TLLAMA_PROFILES))
ifneq ($(UNKNOWN_PROFILES),)
$(error unknown tllama-server build profile: $(UNKNOWN_PROFILES))
endif

ifneq ($(filter pkg.tllama-server.all,$(TLLAMA_PROFILES)),)
COMPONENTS := $(COMPONENT_ORDER)
else ifneq ($(TLLAMA_PROFILES),)
REQUESTED_COMPONENTS := $(patsubst pkg.tllama-server.%-only,%,$(TLLAMA_PROFILES))
COMPONENTS := $(filter $(REQUESTED_COMPONENTS),$(COMPONENT_ORDER))
else
COMPONENTS := cpu vulkan
endif
OTHER_PROFILES := $(filter-out pkg.tllama-server.%,$(DEB_BUILD_PROFILES))

%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=build-debian

# One debhelper sequence owns the package set, .changes and signing. Dispatch
# only the native phases, not recursive binary-package builds or dh sequences.
# Components run sequentially; each compiler can use the requested parallelism.
override_dh_auto_configure override_dh_auto_build override_dh_auto_install override_dh_shlibdeps override_dh_auto_clean:
	+set -e; for component in $(COMPONENTS); do \
		$(MAKE) --no-print-directory -f debian/build-component.mk $@ \
			DEB_BUILD_PROFILES="$(OTHER_PROFILES) pkg.tllama-server.$$component-only"; \
	done

override_dh_auto_test:
	# check-runtime.py validates the staged core/CPU installation at install time.
	:

override_dh_makeshlibs:
	# Private SONAME metadata is created per component during dh_shlibdeps.
	:

execute_after_dh_installdocs:
	dh_lintian
