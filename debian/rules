#!/usr/bin/make -f

include /usr/share/dpkg/default.mk
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

CORE_PACKAGE = tllama-server-core
CPU_PACKAGE = tllama-server-backend-cpu
VULKAN_PACKAGE = tllama-server-backend-vulkan
CUDA_PACKAGE = tllama-server-backend-cuda12.4
CUDA_TARGETS = 50-virtual;60;61-virtual;70-virtual;75-virtual;80-virtual;86-real;89-real;90-virtual
ROCM_PACKAGE = tllama-server-backend-rocm10.1
ROCM_ROOT = /opt/rocm/core-10.1
ROCM_TARGETS = gfx908;gfx90a;gfx942;gfx950;gfx1010;gfx1011;gfx1012;gfx1030;gfx1031;gfx1032;gfx1033;gfx1034;gfx1035;gfx1036;gfx1100;gfx1101;gfx1102;gfx1103;gfx1150;gfx1151;gfx1152;gfx1153;gfx1200;gfx1201;gfx1250
RUNTIME_DIR = usr/lib/tllama/server
CPU_ONLY = $(filter pkg.tllama-server.cpu-only,$(DEB_BUILD_PROFILES))
VULKAN_ONLY = $(filter pkg.tllama-server.vulkan-only,$(DEB_BUILD_PROFILES))
ROCM_ONLY = $(filter pkg.tllama-server.rocm-only,$(DEB_BUILD_PROFILES))
CUDA_ONLY = $(filter pkg.tllama-server.cuda12.4-only,$(DEB_BUILD_PROFILES))
BACKEND_ONLY = $(strip $(VULKAN_ONLY) $(ROCM_ONLY) $(CUDA_ONLY))
SELECTED_PROFILES = $(strip $(CPU_ONLY) $(VULKAN_ONLY) $(ROCM_ONLY) $(CUDA_ONLY))

ifneq ($(word 2,$(SELECTED_PROFILES)),)
$(error select only one tllama-server build profile)
endif

ifeq ($(BACKEND_ONLY),)
BUILD_DIR = build-debian
BUILD_SERVER = ON
BUILD_CPU = ON
else
BUILD_SERVER = OFF
BUILD_CPU = OFF
ifneq ($(ROCM_ONLY),)
BUILD_DIR = build-debian-rocm10.1
else
ifneq ($(CUDA_ONLY),)
BUILD_DIR = build-debian-cuda12.4
else
BUILD_DIR = build-debian-vulkan
endif
endif
endif

ifeq ($(strip $(CPU_ONLY) $(ROCM_ONLY) $(CUDA_ONLY)),)
BUILD_VULKAN = ON
else
BUILD_VULKAN = OFF
endif

%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=$(BUILD_DIR)

override_dh_auto_configure:
ifneq ($(ROCM_ONLY),)
	test -x $(ROCM_ROOT)/bin/hipcc
	test -x $(ROCM_ROOT)/lib/llvm/bin/clang++
	test -f $(ROCM_ROOT)/include/hip/hip_fp16.h
	test -d $(ROCM_ROOT)/amdgcn/bitcode
	grep -Eq '^10\.1([.]|$$)' $(ROCM_ROOT)/.info/version
	test ! -e /usr/include/hip/hip_fp16.h || { \
		echo "legacy HIP headers found in /usr/include/hip; remove libamdhip64-dev before building ROCm 10.1" >&2; \
		exit 1; \
	}
	env HIP_PLATFORM=amd HIP_PATH=$(ROCM_ROOT) ROCM_PATH=$(ROCM_ROOT) \
		HIP_CLANG_PATH=$(ROCM_ROOT)/lib/llvm/bin \
		HIP_INCLUDE_PATH=$(ROCM_ROOT)/include \
		HIP_DEVICE_LIB_PATH=$(ROCM_ROOT)/amdgcn/bitcode \
		DEVICE_LIB_PATH=$(ROCM_ROOT)/amdgcn/bitcode \
		PATH=$(ROCM_ROOT)/bin:$(ROCM_ROOT)/lib/llvm/bin:$$PATH \
		dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DTLLAMA_BUILD_SERVER=OFF \
		-DTLLAMA_INSTALL_LIBDIR=lib/tllama/server \
		-DTLLAMA_BACKEND_INSTALL_DIR=lib/tllama/server/backends/rocm10.1 \
		-DTLLAMA_BACKEND_RPATH=$(ROCM_ROOT)/lib \
		-DCMAKE_HIP_COMPILER=$(ROCM_ROOT)/lib/llvm/bin/clang++ \
		-DCMAKE_HIP_COMPILER_ROCM_ROOT=$(ROCM_ROOT) \
		-DCMAKE_PREFIX_PATH=$(ROCM_ROOT)/lib/cmake \
		-Dhip_DIR=$(ROCM_ROOT)/lib/cmake/hip \
		-Dhipblas_DIR=$(ROCM_ROOT)/lib/cmake/hipblas \
		-Drocblas_DIR=$(ROCM_ROOT)/lib/cmake/rocblas \
		-DCMAKE_HIP_ARCHITECTURES="$(ROCM_TARGETS)" \
		-DGGML_CPU=OFF \
		-DGGML_BLAS=OFF \
		-DGGML_HIP=ON \
		-DGGML_HIP_GRAPHS=ON \
		-DGGML_HIP_RCCL=OFF \
		-DGGML_HIP_NO_VMM=ON \
		-DGGML_CUDA=OFF \
		-DGGML_VULKAN=OFF \
		-DGGML_SYCL=OFF
else ifneq ($(CUDA_ONLY),)
	/usr/bin/nvcc --version | grep -Eq 'release 12\.4([, ])'
	# Include a dedicated sm_60 image for Pascal P100 FP16 kernels.
	# /usr/bin/nvcc selects Debian's toolkit, independently of /usr/local CUDA.
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DTLLAMA_BUILD_SERVER=OFF \
		-DTLLAMA_INSTALL_LIBDIR=lib/tllama/server \
		-DTLLAMA_BACKEND_INSTALL_DIR=lib/tllama/server/backends/cuda12.4 \
		-DTLLAMA_BACKEND_RPATH= \
		-DCMAKE_CUDA_COMPILER=/usr/bin/nvcc \
		-DCMAKE_CUDA_ARCHITECTURES="$(CUDA_TARGETS)" \
		-DGGML_CPU=OFF \
		-DGGML_BLAS=OFF \
		-DGGML_CUDA=ON \
		-DGGML_CUDA_GRAPHS=ON \
		-DGGML_CUDA_NCCL=OFF \
		-DGGML_HIP=OFF \
		-DGGML_VULKAN=OFF \
		-DGGML_SYCL=OFF
else
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DTLLAMA_BUILD_SERVER=$(BUILD_SERVER) \
		-DTLLAMA_INSTALL_LIBDIR=lib/tllama/server \
		-DTLLAMA_BACKEND_INSTALL_DIR=lib/tllama/server \
		-DTLLAMA_BACKEND_RPATH= \
		-DGGML_CPU=$(BUILD_CPU) \
		-DGGML_CPU_ALL_VARIANTS=$(BUILD_CPU) \
		-DGGML_BLAS=$(BUILD_CPU) \
		-DGGML_BLAS_VENDOR=OpenBLAS \
		-DGGML_CUDA=OFF \
		-DGGML_HIP=OFF \
		-DGGML_VULKAN=$(BUILD_VULKAN) \
		-DGGML_SYCL=OFF
endif

override_dh_auto_test:
	# The CPU runtime check below uses the installed component layout.
	:

override_dh_auto_install:
ifeq ($(BACKEND_ONLY),)
	DESTDIR=$(CURDIR)/debian/$(CORE_PACKAGE) \
		cmake --install $(BUILD_DIR) --component core
	DESTDIR=$(CURDIR)/debian/$(CPU_PACKAGE) \
		cmake --install $(BUILD_DIR) --component backend-cpu
	DESTDIR=$(CURDIR)/debian/$(CPU_PACKAGE) \
		cmake --install $(BUILD_DIR) --component backend-blas
	python3 debian/check-runtime.py debian/$(CORE_PACKAGE) debian/$(CPU_PACKAGE)
endif
ifeq ($(strip $(CPU_ONLY) $(ROCM_ONLY) $(CUDA_ONLY)),)
	DESTDIR=$(CURDIR)/debian/$(VULKAN_PACKAGE) \
		cmake --install $(BUILD_DIR) --component backend-vulkan
endif
ifneq ($(ROCM_ONLY),)
	DESTDIR=$(CURDIR)/debian/$(ROCM_PACKAGE) \
		cmake --install $(BUILD_DIR) --component backend-hip
endif

ifneq ($(CUDA_ONLY),)
	DESTDIR=$(CURDIR)/debian/$(CUDA_PACKAGE) \
		cmake --install $(BUILD_DIR) --component backend-cuda
endif

override_dh_makeshlibs:
	# These SONAMEs are private to this distribution, not global library APIs.
	# Provide build-local metadata without publishing global shlibs or adding
	# ldconfig maintainer scripts to the packages.
	{ \
		for library in ggml-base ggml llama llama-common mtmd; do \
			printf 'lib%s 0 $(CORE_PACKAGE) (= $(DEB_VERSION))\n' "$$library"; \
		done; \
		if [ -n "$(CUDA_ONLY)" ]; then \
			printf 'libcuda 1 libcuda1 (>= 525.60.13)\n'; \
		fi; \
	} > debian/shlibs.local

override_dh_shlibdeps:
ifeq ($(BACKEND_ONLY),)
	dh_shlibdeps -p$(CORE_PACKAGE) \
		-l$(CURDIR)/debian/$(CORE_PACKAGE)/$(RUNTIME_DIR) \
		-- -x$(CORE_PACKAGE)
	dh_shlibdeps -p$(CPU_PACKAGE) \
		-l$(CURDIR)/debian/$(CORE_PACKAGE)/$(RUNTIME_DIR) \
		-- -x$(CORE_PACKAGE)
endif
ifeq ($(strip $(CPU_ONLY) $(ROCM_ONLY) $(CUDA_ONLY)),)
	# In a backend-only build, resolve ggml-base from this build tree. Local
	# shlibs metadata maps it to the exact core package version; the common
	# library itself is not included in the Vulkan package.
	dh_shlibdeps -p$(VULKAN_PACKAGE) \
		-l$(CURDIR)/$(BUILD_DIR)/bin \
		-- -x$(CORE_PACKAGE)
endif
ifneq ($(ROCM_ONLY),)
	# AMD's versioned packages supply the HIP/BLAS runtime dependencies
	# explicitly; shlibdeps still collects the standard Debian libraries.
	dh_shlibdeps -p$(ROCM_PACKAGE) \
		-l$(CURDIR)/$(BUILD_DIR)/bin:$(ROCM_ROOT)/lib \
		-- -x$(CORE_PACKAGE) --ignore-missing-info
endif

ifneq ($(CUDA_ONLY),)
	# Debian supplies CUDA runtime metadata; libcuda may resolve to a toolkit
	# stub during linking, so local metadata maps it to the real driver package.
	dh_shlibdeps -p$(CUDA_PACKAGE) \
		-l$(CURDIR)/$(BUILD_DIR)/bin:/usr/lib/$(DEB_HOST_MULTIARCH) \
		-- -x$(CORE_PACKAGE)
endif

override_dh_auto_clean:
	# Preserve the other profile's CMake tree, but remove package staging
	# output from every profile before dpkg-source collects debian/.
	rm -rf $(BUILD_DIR) debian/tllama-server \
		debian/$(CORE_PACKAGE) debian/$(CPU_PACKAGE) debian/$(VULKAN_PACKAGE) \
		debian/$(ROCM_PACKAGE) debian/$(CUDA_PACKAGE)
	rm -f debian/shlibs.local debian/*.substvars debian/*.debhelper
