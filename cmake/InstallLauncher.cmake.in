# The relative link works with DESTDIR staging and a relocated installation.
set(launcher_dir "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@")
set(launcher "${launcher_dir}/tllama-server")
file(MAKE_DIRECTORY "${launcher_dir}")

# Refuse to overwrite an unrelated executable during a manual installation.
if(IS_SYMLINK "${launcher}")
    file(READ_SYMLINK "${launcher}" existing_target)
    if(NOT existing_target STREQUAL "@TLLAMA_LAUNCHER_TARGET@")
        message(FATAL_ERROR "Existing tllama-server symlink points to a different runtime")
    endif()
elseif(EXISTS "${launcher}")
    message(FATAL_ERROR "Refusing to overwrite ${launcher}")
endif()

file(CREATE_LINK "@TLLAMA_LAUNCHER_TARGET@" "${launcher}" SYMBOLIC RESULT link_result)
if(NOT link_result STREQUAL "0")
    message(FATAL_ERROR "Cannot create tllama-server launcher: ${link_result}")
endif()
list(APPEND CMAKE_INSTALL_MANIFEST_FILES "${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@/tllama-server")
